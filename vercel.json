{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/players",
      "destination": "/index.html"
    },
    {
      "source": "/timeline",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/editor.js": {
      "maxDuration": 60,
      "includeFiles": "{data/**,public/assets/**}"
    }
  }
}
